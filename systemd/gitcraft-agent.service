[Unit]
Description=GitCraft deployment agent (one reconciliation)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=minecraft
Group=minecraft
Environment=PATH=/usr/bin:/bin
EnvironmentFile=/etc/gitcraft/secrets.env
ExecStart=/opt/gitcraft/bin/gitcraft agent --config /etc/gitcraft/config/agent.yml --once
TimeoutStartSec=30min
UMask=0027
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minecraft
# sudo is limited to three operations on minecraft.service; NoNewPrivileges would block it.

