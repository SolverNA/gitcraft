[Unit]
Description=Minecraft managed by GitCraft
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/var/lib/minecraft/server
EnvironmentFile=/etc/gitcraft/java.env
ExecStart=/usr/bin/java $JAVA_OPTS -jar server.jar nogui
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minecraft/server

[Install]
WantedBy=multi-user.target
